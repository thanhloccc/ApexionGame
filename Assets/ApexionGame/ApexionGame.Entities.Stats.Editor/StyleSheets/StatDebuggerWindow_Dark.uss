/* The only place literal colours are allowed. */

:root {
    --stat-debugger-border: rgb(30, 30, 30);
    --stat-debugger-chrome: rgb(50, 50, 50);
    --stat-debugger-header-bg: rgb(58, 58, 58);
    --stat-debugger-row-hover: rgb(66, 66, 66);
    --stat-debugger-row-alt: rgb(48, 48, 48);
    --stat-debugger-selection: rgb(58, 90, 132);
    --stat-debugger-text: rgb(203, 203, 203);
    --stat-debugger-muted: rgb(138, 138, 138);
    --stat-debugger-accent: rgb(122, 192, 255);
    --stat-debugger-danger-text: rgb(255, 186, 186);
    --stat-debugger-danger-bg: rgb(102, 42, 42);

    --stat-graph-bg: rgb(43, 43, 43);
    --stat-graph-node-bg: rgb(60, 60, 60);

    /* Match the Painter2D colours in StatGraphView exactly, so the legend never drifts from
       what is actually drawn (those two are C# Color literals, not USS, and are not themed). */
    --stat-graph-edge: rgb(107, 140, 178);
    --stat-graph-edge-cycle: rgb(232, 92, 92);

    /* Inset look for text fields — lighter border than the chrome bar so it reads as an input
       instead of blending into the toolbar/section header behind it. */
    --stat-debugger-input-bg: rgb(36, 36, 36);
    --stat-debugger-input-border: rgb(96, 96, 96);

    /* The owner list / stats rows / graph canvas are all "content", one shade off from the
       --stat-debugger-chrome used by every toolbar and section-header bar — without this the
       whole window read as one flat grey with only 1-2px lines marking panel boundaries. */
    --stat-debugger-content-bg: rgb(40, 40, 40);

    /* Selection/focus uses amber, deliberately a different hue from the blue "modified" accent —
       the first pass reused accent blue for both and a selected-and-modified row/node became
       impossible to tell apart from a merely-modified one. */
    --stat-debugger-focus: rgb(255, 179, 71);
    --stat-debugger-focus-bg: rgba(255, 179, 71, 0.20);

    --stat-debugger-button-bg: rgb(68, 68, 68);
    --stat-debugger-button-border: rgb(96, 96, 96);

    /* Tinted fills for the legend chips — a 1px border alone was nearly invisible against the
       dark node background, so modified/foreign/cycle also get a soft background wash. */
    --stat-debugger-accent-tint: rgba(122, 192, 255, 0.22);
    --stat-debugger-danger-tint: rgba(255, 130, 130, 0.22);
    --stat-debugger-muted-tint: rgba(170, 170, 170, 0.18);
}
