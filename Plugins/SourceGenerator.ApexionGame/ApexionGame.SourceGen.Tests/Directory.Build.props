<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <UnityProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)/../../..'))</UnityProjectPath>
        <UnityInstallRootPath>$([System.Environment]::GetEnvironmentVariable('UNITY_OS_INSTALL_ROOT'))</UnityInstallRootPath>

        <!--
            Derived directly instead of relying on the Unity3D NuGet package, so the test project
            restores without network access. Both may be empty; UnityDllPaths.targets degrades
            to an empty DLL list and the integration tests report Inconclusive.
        -->
        <UnityModulesPath Condition="'$(UnityInstallRootPath)' != ''">$(UnityInstallRootPath)/Editor/Data/Managed/UnityEngine</UnityModulesPath>
        <UnityScriptAssembliesPath>$(UnityProjectPath)/Library/ScriptAssemblies</UnityScriptAssembliesPath>
    </PropertyGroup>
</Project>
