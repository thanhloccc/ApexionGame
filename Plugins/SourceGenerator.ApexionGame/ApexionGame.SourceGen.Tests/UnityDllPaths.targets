<Project>

    <!--
        GenerateUnityDllPaths / DeleteUnityDllPaths
        ============================================
        Generates Helpers/UnityDllPaths.g.cs before every build, then deletes it afterwards.
        It implements the partial methods declared in Helpers/UnityDllPaths.cs.

        Unlike the upstream version this target does NOT fail the build when Unity paths cannot be
        resolved. Tests come in two tiers (doc 4.5.3): stub-based tests need nothing, integration
        tests need the real Unity DLLs. Failing the whole build would take the first tier down with
        the second, so instead the DLL list comes out empty and the integration tests report
        Inconclusive with an actionable message.

        The target adds the file to @(Compile) itself. It has to: the SDK's default **/*.cs glob is
        expanded during evaluation, which happens before any target runs, and DeleteUnityDllPaths
        removes the file after every build — so the glob never sees it and the partial methods stay
        unimplemented. That silently downgraded every integration test to Inconclusive while
        `dotnet test` still printed "Passed!".
    -->

    <!-- Belt and braces: if a previous build was interrupted before the delete, the glob would
         have picked the file up and this Include would make it a duplicate. -->
    <ItemGroup>
        <Compile Remove="Helpers/UnityDllPaths.g.cs" />
    </ItemGroup>

    <Target Name="GenerateUnityDllPaths" BeforeTargets="BeforeBuild">
        <PropertyGroup>
            <_UnityDllPathsFile>$(MSBuildProjectDirectory)/Helpers/UnityDllPaths.g.cs</_UnityDllPathsFile>
            <_UnityPathsResolved Condition="Exists('$(UnityModulesPath)') AND Exists('$(UnityScriptAssembliesPath)')">true</_UnityPathsResolved>
        </PropertyGroup>

        <Warning Condition="'$(_UnityPathsResolved)' != 'true'"
                 Text="Unity DLL paths unresolved (UnityModulesPath='$(UnityModulesPath)', UnityScriptAssembliesPath='$(UnityScriptAssembliesPath)'). Set UNITY_OS_INSTALL_ROOT and open the Unity project once. Integration tests will be skipped." />

        <ItemGroup Condition="'$(_UnityPathsResolved)' == 'true'">
            <_UnityDll Include="$(UnityModulesPath)/UnityEngine.CoreModule.dll" />
            <_UnityDll Include="$(UnityScriptAssembliesPath)/Unity.Burst.dll" />
            <_UnityDll Include="$(UnityScriptAssembliesPath)/Unity.Collections.dll" />
            <_UnityDll Include="$(UnityScriptAssembliesPath)/Unity.Mathematics.dll" />
            <_UnityDll Include="$(UnityScriptAssembliesPath)/EncosyTower.Core.dll" />
            <_UnityDll Include="$(UnityScriptAssembliesPath)/ApexionGame.Entities.Stats.dll" />
        </ItemGroup>

        <Error Condition="'$(_UnityPathsResolved)' == 'true' AND !Exists('%(_UnityDll.Identity)')"
               Text="Required Unity DLL not found: '%(_UnityDll.Identity)'. Open the Unity project so Library/ScriptAssemblies is populated." />

        <ItemGroup>
            <_UnityDllPathsLines Include="// &lt;auto-generated/&gt;" />
            <_UnityDllPathsLines Include="// This file is generated by the build system. Do not edit manually." />
            <_UnityDllPathsLines Include=" " />
            <_UnityDllPathsLines Include="namespace ApexionGame.SourceGen.Tests%3B" />
            <_UnityDllPathsLines Include=" " />
            <_UnityDllPathsLines Include="internal static partial class UnityDllPaths" />
            <_UnityDllPathsLines Include="{" />
            <!-- `new string[]`, not `new[]`: with no Unity DLLs the initializer is empty, and an
                 empty implicitly-typed array is CS0826. -->
            <_UnityDllPathsLines Include="    static partial void InitAll(ref string[] value) =&gt; value = new string[]" />
            <_UnityDllPathsLines Include="    {" />
        </ItemGroup>
        <!-- Condition repeated here on purpose: batching over an *empty* item list still emits one
             line, with the metadata expanded to nothing. That produced a single @"" entry, which
             made IsResolved true and crashed every integration test on an empty path. -->
        <ItemGroup Condition="'$(_UnityPathsResolved)' == 'true'">
            <_UnityDllPathsLines Include="        @&quot;%(_UnityDll.Identity)&quot;," />
        </ItemGroup>
        <ItemGroup>
            <_UnityDllPathsLines Include="    }%3B" />
            <_UnityDllPathsLines Include=" " />
            <_UnityDllPathsLines Include="    static partial void InitUnityModulesPath(ref string value)" />
            <_UnityDllPathsLines Include="        =&gt; value = @&quot;$(UnityModulesPath)&quot;%3B" />
            <_UnityDllPathsLines Include=" " />
            <_UnityDllPathsLines Include="    static partial void InitUnityScriptAssembliesPath(ref string value)" />
            <_UnityDllPathsLines Include="        =&gt; value = @&quot;$(UnityScriptAssembliesPath)&quot;%3B" />
            <_UnityDllPathsLines Include="}" />
        </ItemGroup>

        <WriteLinesToFile File="$(_UnityDllPathsFile)" Lines="@(_UnityDllPathsLines)" Overwrite="true" Encoding="UTF-8" />

        <ItemGroup>
            <Compile Include="$(_UnityDllPathsFile)" />
        </ItemGroup>
    </Target>

    <Target Name="DeleteUnityDllPaths" AfterTargets="AfterBuild">
        <Delete Files="$(MSBuildProjectDirectory)/Helpers/UnityDllPaths.g.cs" />
    </Target>

</Project>
